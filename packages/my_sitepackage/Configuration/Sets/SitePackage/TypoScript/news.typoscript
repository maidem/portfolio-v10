# ─── EXT:news — Frontend Rendering Definitions ────────────────────────────────
# tt_content.news_* USER objects must be defined explicitly; EXT:news does not
# provide them via its Site Set TypoScript.

tt_content.news_pi1 = USER
tt_content.news_pi1 {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = News
    pluginName = Pi1
    vendorName = GeorgRinger
}

tt_content.news_categorylist < tt_content.news_pi1
tt_content.news_categorylist.pluginName = CategoryList

tt_content.news_newsliststicky < tt_content.news_pi1
tt_content.news_newsliststicky.pluginName = NewsListSticky

tt_content.news_newsdetail < tt_content.news_pi1
tt_content.news_newsdetail.pluginName = NewsDetail

tt_content.news_newsselectedlist < tt_content.news_pi1
tt_content.news_newsselectedlist.pluginName = NewsSelectedList

tt_content.news_newsdatemenu < tt_content.news_pi1
tt_content.news_newsdatemenu.pluginName = NewsDateMenu

tt_content.news_newssearchform < tt_content.news_pi1
tt_content.news_newssearchform.pluginName = NewsSearchForm

tt_content.news_newssearchresult < tt_content.news_pi1
tt_content.news_newssearchresult.pluginName = NewsSearchResult

tt_content.news_taglist < tt_content.news_pi1
tt_content.news_taglist.pluginName = TagList

# ─── EXT:news — Template Overrides & Plugin Settings ─────────────────────────

plugin.tx_news {
    view {
        templateRootPaths {
            0 = EXT:news/Resources/Private/Templates/
            10 = EXT:my_sitepackage/Resources/Private/Extensions/News/Templates/
        }
        partialRootPaths {
            0 = EXT:news/Resources/Private/Partials/
            10 = EXT:my_sitepackage/Resources/Private/Extensions/News/Partials/
        }
        layoutRootPaths {
            0 = EXT:news/Resources/Private/Layouts/
            10 = EXT:my_sitepackage/Resources/Private/Extensions/News/Layouts/
        }
    }
    settings {
        list {
            paginate {
                itemsPerPage = 50
                insertAbove = 0
                insertBelow = 0
            }
            media {
                image {
                    maxWidth = 800
                    maxHeight = 450
                }
            }
        }
        detail {
            showPrevNext = 1
            redirectToExternalUrl = 0
            showMetaTags = 0
            checkPidOfNewsRecord = 0
        }
        # Disable dummy image if no media
        displayDummyIfNoMedia = 0
        # No pagination needed for portfolio
        hidePagination = 1
    }
}
