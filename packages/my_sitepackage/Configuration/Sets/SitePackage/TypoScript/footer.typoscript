# Footer Content aus dem Sysfolder laden und rendern
# Nutzt das klassische CONTENT-Objekt (bewährt und stabil)
lib.footer = COA
lib.footer {
    # DEBUG: always output a comment so we can see if lib.footer is loaded and what storagePid resolves to
    5 = TEXT
    5.value = <!-- DEBUG lib.footer: storagePid={$footer.storagePid} -->

    10 = CONTENT
    10 {
        table = tt_content
        select {
            pidInList = {$footer.storagePid}
            where = CType='gripsraum_footer'
            max = 1
        }
    }
}
