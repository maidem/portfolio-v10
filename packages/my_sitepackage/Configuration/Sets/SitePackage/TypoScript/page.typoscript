##############
#### PAGE ####
##############
page = PAGE
page {
    typeNum = 0
    shortcutIcon = EXT:my_sitepackage/Resources/Public/Icons/favicon.ico

    10 = PAGEVIEW
    10 {
        paths {
            0 = EXT:my_sitepackage/Resources/Private/PageView/
            1 = {$page.pageview.paths}
        }
        variables {
            # nav_title overrides the wordmark if set (e.g. root page = "Über mich"),
            # otherwise falls back to the regular page title.
            pageTitle = TEXT
            pageTitle.data = page:nav_title // page:title

            # Expose current page uid for active-link detection in Fluid layouts
            pageUid = TEXT
            pageUid.data = page:uid

        }
        dataProcessing {
            10 = files
            10 {
                references.fieldName = media
            }
            20 = menu
            20 {
                levels = 2
                includeSpacer = 1
                as = mainnavigation
            }
            30 = page-content
        }
    }

    meta {
        viewport = {$page.meta.viewport}
        robots = {$page.meta.robots}
        apple-mobile-web-app-capable = {$page.meta.apple-mobile-web-app-capable}

        theme-color = #ffffff
        theme-color {
            attribute = name
        }

        X-UA-Compatible = {$page.meta.compatible}
        X-UA-Compatible {
            attribute = http-equiv
        }
    }

    headerData {
        # Bottom-Sheet erst zeigen, wenn das echte CSS da ist.
        20 = TEXT
        20.value (
            <style>.cb-nav__overlay:not(.cb-nav__overlay--open),.cb-nav__backdrop:not(.cb-nav__backdrop--open){visibility:hidden}</style>
        )
        # Ohne das rendert die Seite bis zum Eintreffen des Vite-CSS mit dem
        # Browser-Default body{margin:8px} und springt dann (CLS 0.75).
        # main padding-top haelt den Platz der fixed Nav frei, section-Abstaende
        # geben schon vor dem Vite-CSS die richtige Hoehe -> kein Sprung in der
        # Navleiste / im Inhalt beim Seitenwechsel (v.a. im Vite-Dev-Modus, wo
        # das CSS per JS nachgeladen wird).
        30 = TEXT
        30.value (
            <style>body{margin:0}html{scrollbar-gutter:stable}.cb-nav{position:fixed;top:0;left:0;right:0;z-index:100;min-height:3.5rem}main{padding-top:3.5rem}main>*{margin-bottom:clamp(5rem,12vh,9rem)}main>*:last-child{margin-bottom:0}main>.container,main>section,main>.frame{padding-top:1.5rem}@media(min-width:768px){main>.container,main>section,main>.frame{padding-top:2rem}}</style>
        )
        # Linienraster sofort korrekt positionieren, sonst blitzt das SVG bis
        # zum Eintreffen des Vite-CSS ungestylt im Dokumentfluss auf.
        40 = TEXT
        40.value (
            <style>.cb-perspective-grid{position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:2}.cb-perspective-grid svg{width:100%;height:100%}@media(max-width:767.98px){.cb-perspective-grid{display:none}}</style>
        )
    }

    includeCSSLibs {

    }

    includeCSS {

    }

    includeJS {

    }

    includeJSFooter {
        # my_sitepackage_scripts = EXT:my_sitepackage/Resources/Public/JavaScript/main.js
    }

    footerData {
        10 = TEXT
        10 {
            value (
                <script>
                  var _paq = window._paq = window._paq || [];
                  _paq.push(['disableCookies']);
                  _paq.push(['trackPageView']);
                  _paq.push(['enableLinkTracking']);
                  (function() {
                    var u="https://matomo.maidem.de/";
                    _paq.push(['setTrackerUrl', u+'matomo.php']);
                    _paq.push(['setSiteId', '1']);
                    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
                    g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
                  })();
                </script>
            )
        }
    }

}

