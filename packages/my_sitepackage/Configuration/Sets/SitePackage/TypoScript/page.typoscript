##############
#### PAGE ####
##############
page = PAGE
page {
    typeNum = 0
    shortcutIcon = EXT:my_sitepackage/Resources/Public/Icons/favicon.ico

    10 = PAGEVIEW
    10 {
        paths {
            0 = EXT:my_sitepackage/Resources/Private/PageView/
            1 = {$page.pageview.paths}
        }
        dataProcessing {
            10 = files
            10 {
                references.fieldName = media
            }
            20 = menu
            20 {
                levels = 2
                includeSpacer = 1
                as = mainnavigation
            }
            30 = page-content

            # One-pager: read content elements with section_anchor to build anchor navigation
            40 = database-query
            40 {
                table = tt_content
                pidInList.data = page:uid
                where = section_anchor != ''
                orderBy = sorting
                as = sectionNavigation
            }

            # Global nav fallback: always fetch homepage sections for use on detail pages
            50 = database-query
            50 {
                table = tt_content
                pidInList.data = leveluid:0
                where = section_anchor != ''
                orderBy = sorting
                as = homeNavigation
            }
        }
    }

    meta {
        viewport = {$page.meta.viewport}
        robots = {$page.meta.robots}
        apple-mobile-web-app-capable = {$page.meta.apple-mobile-web-app-capable}

        theme-color = #ffffff
        theme-color {
            attribute = name
        }

        X-UA-Compatible = {$page.meta.compatible}
        X-UA-Compatible {
            attribute = http-equiv
        }
    }

    includeCSSLibs {

    }

    includeCSS {
        critical-nav = EXT:my_sitepackage/Resources/Public/Css/critical-nav.css
    }

    includeJS {

    }

    includeJSFooter {
        # my_sitepackage_scripts = EXT:my_sitepackage/Resources/Public/JavaScript/main.js
    }
}

