  <file datatype="plaintext" original="labels.xlf" source-language="en" target-language="de" date="2026-03-18T12:00:00+00:00" product-name="gripsraum/skills">
    <header/>
    <body>
      <trans-unit id="title">
        <source>Skills</source>
        <target>Skills</target>
      </trans-unit>
      <trans-unit id="description">
        <source>A block to display categorized skills with pill-shaped buttons.</source>
        <target>Ein Block zur Darstellung kategorisierter Skills als abgerundete Buttons ("Pills").</target>
      </trans-unit>
      <trans-unit id="skill_collections.label">
        <source>Skills</source>
        <target>Skills</target>
      </trans-unit>
      <trans-unit id="skill_collections.description">
        <source>Add one entry per skill.</source>
        <target>Füge je einen Eintrag pro Skill hinzu.</target>
      </trans-unit>
      <trans-unit id="skill_name.label">
        <source>Skill</source>
        <target>Skill</target>
      </trans-unit>
      <trans-unit id="skill_category.label">
        <source>Category</source>
        <target>Kategorie</target>
      </trans-unit>
      <trans-unit id="skill_category.description">
        <source>e.g. CMS Systems, Frameworks, Languages — used as filter tab</source>
        <target>z. B. CMS-Systeme, Frameworks, Sprachen — wird als Filter-Tab angezeigt</target>
      </trans-unit>
      <trans-unit id="skill_categories.label">
        <source>Filter Categories</source>
        <target>Filter-Kategorien</target>
      </trans-unit>
      <trans-unit id="skill_categories.description">
        <source>Define the available filter categories here. Assign them to individual skills below.</source>
        <target>Lege hier die verfügbaren Filter-Kategorien an. Diese können dann den einzelnen Skills zugeordnet werden.</target>
      </trans-unit>
      <trans-unit id="category_name.label">
        <source>Category name</source>
        <target>Kategoriename</target>
      </trans-unit>
      <trans-unit id="skill_workflows.label">
        <source>Workflows</source>
        <target>Workflows</target>
      </trans-unit>
      <trans-unit id="skill_workflows.description">
        <source>Define tool/tech workflows shown as connected step chains in the frontend.</source>
        <target>Definiere Tool-/Tech-Workflows, die im Frontend als verkettete Schritte angezeigt werden.</target>
      </trans-unit>
      <trans-unit id="workflow_name.label">
        <source>Workflow name</source>
        <target>Workflow-Name</target>
      </trans-unit>
      <trans-unit id="workflow_name.description">
        <source>Label shown on the filter button, e.g. "CMS Deployment"</source>
        <target>Beschriftung des Filter-Buttons, z. B. „CMS-Deployment“</target>
      </trans-unit>
      <trans-unit id="workflow_steps.label">
        <source>Steps</source>
        <target>Schritte</target>
      </trans-unit>
      <trans-unit id="step_name.label">
        <source>Step / Tool</source>
        <target>Schritt / Tool</target>
      </trans-unit>
    </body>
