# Content element rendering — standard TYPO3 FLUIDTEMPLATE, no ContentBlocks dependency
tt_content.maidem_pdfexport = FLUIDTEMPLATE
tt_content.maidem_pdfexport {
    templateRootPaths {
        10 = EXT:maidem_pdfexport/Resources/Private/Templates/ContentElements/
    }
    templateName = PdfExport
    dataProcessing {
        10 = Maidem\PdfExport\DataProcessing\PdfExportDataProcessor
    }
}

# PageType 1711 — renders only the PDF, no page header/footer
pdf_export = PAGE
pdf_export {
    typeNum = 1711
    config {
        disableAllHeaderCode = 1
        xhtml_cleaning = 0
        admPanel = 0
        debug = 0
        no_cache = 1
    }
    10 = USER_INT
    10 {
        userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
        extensionName = PdfExport
        pluginName = PdfExport
        vendorName = Maidem
        controller = PdfExport
        action = generate
    }
}
