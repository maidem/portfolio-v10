# Dedicated Chromium service for PDF generation.
#
# Runs Chromium in headless mode with the Chrome DevTools Protocol (CDP)
# exposed on port 9222. The main TYPO3 app container connects to this service
# via Spatie Browsershot's setRemoteInstance() — no local Chromium binary needed
# in the app container.
#
# Coolify: deploy this as a separate service in the same project/network.
# Set BROWSERSHOT_CHROME_HOST=<service-name> in the app container env vars.

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    fonts-liberation \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# The entrypoint script detects the container's actual Docker-network IP at
# runtime and passes it as --remote-debugging-address. This ensures that the
# webSocketDebuggerUrl returned by /json/version contains a routable IP so
# that Puppeteer (which does NOT rewrite 0.0.0.0 URLs) can connect from the
# TYPO3 app container.
COPY docker/chromium/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 9222

ENTRYPOINT ["/entrypoint.sh"]
